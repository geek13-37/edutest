# ── Backend ──────────────────────────────────────────────
DATABASE_URL="postgresql+psycopg://edutest:edutest@localhost:5432/edutest"
JWT_SECRET="generate-a-long-random-string"
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
FRONTEND_ORIGIN="http://localhost:5173"
# первый администратор создаётся автоматически при старте контейнера backend из этих переменных
# (можно и вручную: docker compose run --rm backend python scripts/create_admin.py)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong"
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="minimax/minimax-m3"
OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b:free"
ENV="dev"

# ── Postgres (docker compose) ────────────────────────────
POSTGRES_USER=edutest
POSTGRES_PASSWORD=edutest
POSTGRES_DB=edutest

# ── Frontend (dev) ───────────────────────────────────────
# Куда Vite-dev-server проксирует /api (по умолчанию http://localhost:8000)
VITE_PROXY_TARGET="http://localhost:8000"
